arrow-right w-3.5 h-3.5 rotate-180"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="card-premium group flex flex-col justify-between rounded-2xl p-4 sm:p-5 transition-all duration-300 min-h-[110px]" href="/ar/services/mercedes-fuel-system-repair-dubai"><span class="text-off-white font-bold text-sm sm:text-base leading-tight group-hover:text-burnt-orange">مرسيدس بنز<!-- --> <!-- -->إصلاح نظام الوقود</span><span class="inline-flex items-center gap-1 text-burnt-orange text-xs font-semibold mt-3">اعرف المزيد<!-- --> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5 rotate-180"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="card-premium group flex flex-col justify-between rounded-2xl p-4 sm:p-5 transition-all duration-300 min-h-[110px]" href="/ar/services/mercedes-body-repair-dubai"><span class="text-off-white font-bold text-sm sm:text-base leading-tight group-hover:text-burnt-orange">مرسيدس بنز<!-- --> <!-- -->إصلاح الهيكل</span><span class="inline-flex items-center gap-1 text-burnt-orange text-xs font-semibold mt-3">اعرف المزيد<!-- --> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5 rotate-180"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="card-premium group flex flex-col justify-between rounded-2xl p-4 sm:p-5 transition-all duration-300 min-h-[110px]" href="/ar/services/mercedes-tire-repair-dubai"><span class="text-off-white font-bold text-sm sm:text-base leading-tight group-hover:text-burnt-orange">مرسيدس بنز<!-- --> <!-- -->إصلاح الإطارات</span><span class="inline-flex items-center gap-1 text-burnt-orange text-xs font-semibold mt-3">اعرف المزيد<!-- --> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5 rotate-180"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div><div class="max-w-4xl mx-auto mt-10 sm:mt-14 space-y-6 sm:space-y-8"><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-2">إصلاح مرسيدس بنز في دبي</h3><p class="text-gray-400 text-sm sm:text-base leading-relaxed">يمكن أن يشمل الفحص مشكلات المحرك وناقل الحركة والتعليق والفرامل والتبريد والأنظمة الكهربائية. يُؤكد نطاق الإصلاح المتاح بعد مراجعة السيارة والمشكلة.</p></div><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-2">تغيير زيت مرسيدس بنز في دبي</h3><p class="text-gray-400 text-sm sm:text-base leading-relaxed">يتم تأكيد مواصفة الزيت والفلتر حسب طراز مرسيدس بنز والمحرك. وقد يشمل نطاق الخدمة المتفق عليه فحوصاً إضافية وإعادة ضبط المؤشر عند الحاجة.</p></div><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-2">إصلاح فرامل مرسيدس بنز في دبي</h3><p class="text-gray-400 text-sm sm:text-base leading-relaxed">يمكن أن يشمل الفحص الفحمات والأقراص والحساسات والكليبرات والنظام الهيدروليكي. تعتمد القطع والإجراءات المقترحة على نظام الفرامل المركب في السيارة.</p></div></div></div></section><section id="mercedes-maintenance-scope" class="brand-section scroll-mt-[10rem] border-t border-white/5 bg-charcoal/20 py-12 sm:py-16"><div class="mx-auto max-w-5xl px-4 sm:px-6"><h2 class="text-2xl font-black sm:text-4xl">نطاق صيانة مرسيدس: الخدمة الصغيرة والكبيرة</h2><dl class="mt-7 grid gap-4 sm:grid-cols-2"><div class="card-premium rounded-2xl p-5 sm:p-6"><dt class="text-lg font-bold">الصيانة الأساسية أو الصغيرة</dt><dd class="mt-3 text-sm leading-7 text-white/65">قد تشمل زيت المحرك والفلتر والفحوص المستحقة وفق بيانات السيارة. تغيير الزيت وحده لا يغطي بالضرورة جميع متطلبات الخدمة.</dd></div><div class="card-premium rounded-2xl p-5 sm:p-6"><dt class="text-lg font-bold">الصيانة الموسعة أو الكبيرة</dt><dd class="mt-3 text-sm leading-7 text-white/65">قد تتضمن عناصر إضافية مثل الفلاتر أو شمعات الإشعال أو السوائل عندما يحين موعدها. نحدد كل بند حسب الطراز وسجل الصيانة.</dd></div><div class="card-premium rounded-2xl p-5 sm:p-6"><dt class="text-lg font-bold">Service A وService B</dt><dd class="mt-3 text-sm leading-7 text-white/65">يرتبط نطاق الزيارة ببيانات السيارة ومؤشر ASSYST وسجل الأعمال السابقة. لا نعتمد قائمة موحدة لجميع طرازات مرسيدس.</dd></div><div class="card-premium rounded-2xl p-5 sm:p-6"><dt class="text-lg font-bold">الأعمال الإضافية</dt><dd class="mt-3 text-sm leading-7 text-white/65">تشخيص الأعطال والإصلاحات والتسريبات والإطارات والفرامل وصيانة ناقل الحركة تُدرج بصورة منفصلة ما لم ينص عرض السعر على شمولها.</dd></div></dl><div class="mt-8 max-w-3xl space-y-4 text-sm leading-7 text-white/65"><h3 class="text-xl font-bold text-off-white">ما المعلومات المطلوبة للحجز وعرض السعر؟</h3><p>أرسل رقم الهيكل VIN أو الطراز وسنة الصنع، والمسافة المقطوعة، وصورة رسالة الصيانة، وسجل آخر زيارة إن توفر. اذكر أي تحذير أو تسريب أو صوت غير معتاد حتى نميز بين الصيانة الدورية وتشخيص العطل.</p><p>يوضح العرض قطع الغيار والسوائل والكميات وأجرة العمل والتشخيص والضريبة وأي أعمال غير مشمولة. نؤكد توفر القطع والموعد والمدة المتوقعة قبل بدء العمل.</p><p>الورشة في منطقة القوز الصناعية 3، دبي. للحجز ومعرفة ساعات العمل الحالية اتصل أو راسلنا على ‎+971 4 340 2223 قبل الزيارة.</p><div class="flex flex-wrap gap-x-6 gap-y-3 pt-2"><a class="font-semibold text-burnt-orange hover:underline" href="/ar/services/mercedes-oil-change-dubai">تغيير زيت مرسيدس والفلتر</a><a class="font-semibold text-burnt-orange hover:underline" href="/ar/blog/mercedes-service-cost-dubai-guide">كيف تُحسب تكلفة صيانة مرسيدس؟</a><a class="font-semibold text-burnt-orange hover:underline" href="/ar/blog/mercedes-service-intervals-dubai-heat">مواعيد الصيانة ومؤشر ASSYST</a><a class="font-semibold text-burnt-orange hover:underline" href="/ar/blog/mercedes-benz-maintenance-guide-dubai">تنظيم سجل الصيانة وأولويات الإصلاح</a><a class="font-semibold text-burnt-orange hover:underline" href="/ar/blog/best-oil-change-dubai-mercedes">مقارنة عروض تغيير الزيت</a><a class="font-semibold text-burnt-orange hover:underline" href="/ar/blog/mercedes-repair-dubai-complete-guide">تمييز أعراض الأعطال والخطوة التالية</a></div></div></div></section><section class="border-t border-white/5 bg-black py-10 sm:py-14"><div class="mx-auto max-w-5xl px-4 sm:px-6"><h2 class="text-2xl font-black sm:text-3xl">أدلة صيانة طرازات مرسيدس</h2><p class="mt-3 max-w-3xl text-sm leading-7 text-white/65">تختلف أعمال الفحص والصيانة حسب الجيل والمحرك والتجهيزات. اختر الطراز الأقرب لسيارتك، ثم أرسل رقم الهيكل لتأكيد النطاق المناسب.</p><ul class="mt-6 grid gap-3 sm:grid-cols-2"><li><a class="card-premium flex min-h-14 items-center justify-between gap-3 rounded-xl px-5 py-4 text-sm font-semibold text-white/80 hover:text-burnt-orange" href="/ar/blog/mercedes-c-class-service-dubai-guide">C-Class: ‏C200 وC240 وC300<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 shrink-0"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></li><li><a class="card-premium flex min-h-14 items-center justify-between gap-3 rounded-xl px-5 py-4 text-sm font-semibold text-white/80 hover:text-burnt-orange" href="/ar/blog/mercedes-e-class-service-dubai-guide">E-Class: ‏E200 وE300 وE350<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 shrink-0"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></li><li><a class="card-premium flex min-h-14 items-center justify-between gap-3 rounded-xl px-5 py-4 text-sm font-semibold text-white/80 hover:text-burnt-orange" href="/ar/blog/mercedes-s-class-service-dubai-guide">S-Class: التعليق والراحة والتجهيزات<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 shrink-0"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></li><li><a class="card-premium flex min-h-14 items-center justify-between gap-3 rounded-xl px-5 py-4 text-sm font-semibold text-white/80 hover:text-burnt-orange" href="/ar/blog/mercedes-g63-service-dubai-guide">Mercedes-AMG G63: المحرك والناقل ونظام الدفع<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 shrink-0"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></li></ul></div></section><section class="brand-section brand-section--proof py-12 sm:py-20 bg-black border-t border-white/5"><div class="max-w-5xl mx-auto px-4 sm:px-6"><div class="brand-proof-card card-premium text-center rounded-2xl p-6 sm:p-10"><p class="text-off-white font-bold text-xl sm:text-2xl mb-2">خدمة مستقلة لسيارات مرسيدس بنز في دبي</p><p class="text-gray-400 text-sm sm:text-base mb-8">نخدم دبي منذ عام 2002 مع شرح الفحص والعمل المقترح قبل الموافقة.</p><div class="grid grid-cols-3 gap-4 sm:gap-8 max-w-2xl mx-auto"><div><div class="text-2xl sm:text-4xl font-black text-burnt-orange">2002</div><div class="text-xs sm:text-sm text-gray-400 mt-1">سنة التأسيس</div></div><div><div class="text-2xl sm:text-4xl font-black text-burnt-orange">Al Quoz</div><div class="text-xs sm:text-sm text-gray-400 mt-1">ورشة دبي</div></div><div><div class="text-2xl sm:text-4xl font-black text-burnt-orange">40,000</div><div class="text-xs sm:text-sm text-gray-400 mt-1">قدم مربع مساحة المنشأة</div></div></div></div></div></section><section class="brand-section brand-section--story py-12 sm:py-20 bg-black border-t border-white/5"><div class="max-w-4xl mx-auto px-4 sm:px-6"><article class="brand-story space-y-8 sm:space-y-10"><header><h2 class="text-2xl sm:text-4xl lg:text-5xl font-black mb-4 sm:mb-6 leading-tight">خدمة مستقلة لسيارات <span class="text-burnt-orange">مرسيدس بنز</span> في دبي</h2><p class="text-gray-300 text-base sm:text-lg leading-relaxed">ديجي-تك ورشة مستقلة لصيانة وإصلاح مرسيدس بنز في القوز الصناعية 3 بدبي. نبدأ بوصف المشكلة وبيانات السيارة وسجل صيانتها، ثم نوضح نتائج الفحص والأعمال المقترحة قبل الموافقة على الإصلاح.</p></header><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-3">خدمة تناسب ظروف القيادة في دبي</h3><p class="text-gray-300 text-sm sm:text-base leading-relaxed">تؤخذ حرارة دبي والازدحام والغبار وطريقة الاستخدام في الاعتبار عند فحص التبريد والتكييف والبطارية والسوائل. تعتمد الصيانة المستحقة على تعليمات الطراز ومؤشر ASSYST والسجل والحالة الفعلية؛ ولا تُفرض فترة واحدة على جميع سيارات مرسيدس.</p></div><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-3">نطاق فحص وخدمة سيارات مرسيدس بنز</h3><p class="text-gray-300 text-sm sm:text-base leading-relaxed">يتوفر لدينا تشخيص مرسيدس باستخدام XENTRY لقراءة الأعطال والبيانات وإجراء الفحوص الموجهة. تتوقف وظائف إعادة الضبط والتكييف والبرمجة على الطراز والوحدة والصلاحيات المتاحة، ويُؤكد نطاقها قبل إدراجها في العمل.</p></div><div><h3 class="text-xl sm:text-2xl font-bold text-off-white mb-3">خيارات واضحة للقطع والسوائل</h3><p class="text-gray-300 text-sm sm:text-base leading-relaxed">يوضح عرض السعر القطع والسوائل المقترحة ومطابقتها لرقم الهيكل، إلى جانب أجرة العمل والفحوص المطلوبة. يمكن مناقشة القطع الأصلية أو خيارات الموردين المناسبة بحسب الإصلاح والتوفر وموافقة المالك.</p></div><div class="border-r-2 pr-5 sm:pr-6 border-burnt-orange"><p class="text-gray-200 text-sm sm:text-base leading-relaxed">لحجز فحص مرسيدس في القوز، اتصل على ‎+971 4 340 2223 أو أرسل رسالة واتساب تتضمن الطراز وسنة الصنع والمسافة المقطوعة ونص التحذير أو الأعراض. تساعد هذه التفاصيل في تحديد الفحص الأول المناسب.</p></div></article></div></section><section class="brand-section brand-section--faq scroll-mt-24 py-12 sm:py-20 bg-gradient-to-br from-charcoal/40 to-black border-t border-white/5"><div class="max-w-3xl mx-auto px-4 sm:px-6"><div class="brand-section-heading text-center mb-8 sm:mb-12"><h2 class="text-2xl sm:text-4xl lg:text-5xl font-black mb-3 sm:mb-4">مرسيدس بنز<!-- --> <span class="text-burnt-orange">الأسئلة الشائعة</span></h2><p class="text-gray-400 text-sm sm:text-base">أكثر الأسئلة التي يطرحها ملاك مرسيدس بنز.</p></div><div class="brand-faq space-y-3" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:R9j58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R1j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">متى تحتاج مرسيدس إلى الصيانة في دبي؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:R9j58:" role="region" aria-labelledby="radix-:R1j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">يعتمد الموعد والأعمال المستحقة على بيانات السيارة ومؤشر ASSYST وسجل الصيانة وتعليمات الطراز. نراجع ظروف الاستخدام والحالة الفعلية دون فرض فترة واحدة على جميع السيارات.</div></div></div><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:Raj58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R2j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">ما الفرق بين Service A وService B؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:Raj58:" role="region" aria-labelledby="radix-:R2j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">يشير كل منهما إلى زيارة صيانة، لكن البنود الدقيقة تعتمد على الطراز والعمر والمسافة والأعمال السابقة. نوضح الزيت والفلاتر والفحوص والعناصر الإضافية في عرض السعر.</div></div></div><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:Rbj58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R3j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">هل يتوفر فحص مرسيدس بجهاز XENTRY؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:Rbj58:" role="region" aria-labelledby="radix-:R3j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">نعم، تتوفر لدى ديجي-تك إمكانات تشخيص مرسيدس باستخدام XENTRY. نجمع بين قراءة الأعطال والبيانات والفحص الفعلي. تتوقف وظائف إعادة الضبط والتكييف والبرمجة على الطراز والوحدة والصلاحيات المتاحة، ويُؤكد نطاقها قبل العمل.</div></div></div><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:Rcj58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R4j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">هل تختلف صيانة AMG عن فئات مرسيدس الأخرى؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:Rcj58:" role="region" aria-labelledby="radix-:R4j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">قد تختلف المحركات والقير والفرامل والتعليق والسوائل حسب الجيل والتجهيزات. نتحقق من رقم الهيكل ومواصفات السيارة؛ ولا نعامل حزمة AMG الشكلية كأنها طراز Mercedes-AMG كامل.</div></div></div><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:Rdj58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R5j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">هل تؤكدون القطع والتكلفة قبل الإصلاح؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:Rdj58:" role="region" aria-labelledby="radix-:R5j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">نوضح القطع المقترحة ومطابقتها للسيارة وأجرة العمل ونطاق الفحص قبل التنفيذ. تحتاج النتائج الإضافية إلى توضيح وموافقة قبل توسيع العمل.</div></div></div><div data-state="closed" data-orientation="vertical" class="bg-white/[0.03] border border-white/10 rounded-2xl px-5 sm:px-6 data-[state=open]:border-burnt-orange/40"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:Rej58:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:R6j58:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-right text-off-white font-semibold text-base sm:text-lg hover:no-underline py-5" data-radix-collection-item="">كيف أحجز وكم تستغرق الخدمة؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:Rej58:" role="region" aria-labelledby="radix-:R6j58:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down data-[state=closed]:hidden" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"><div class="pt-0 text-gray-300 text-sm sm:text-base leading-relaxed pb-5">الورشة في القوز الصناعية 3، دبي. اتصل أو راسلنا على ‎+971 4 340 2223 مع بيانات السيارة. نؤكد الموعد والمدة المتوقعة بحسب الفحص وتوفر القطع.</div></div></div></div></div></section><section class="brand-section brand-section--booking scroll-mt-24 py-12 sm:py-20 bg-black border-t border-white/5"><div class="max-w-5xl mx-auto px-4 sm:px-6"><div class="brand-booking-grid grid lg:grid-cols-2 gap-8 lg:gap-12 items-start"><div><h2 class="text-2xl sm:text-4xl lg:text-5xl font-black mb-4 sm:mb-6 leading-tight">احجز خدمة <span class="text-burnt-orange">مرسيدس بنز</span></h2><p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-6">أخبرنا عن سيارتك والخدمة المطلوبة، وسنتواصل معك عبر واتساب بعرض السعر وأقرب موعد متاح.</p><div class="flex flex-col sm:flex-row gap-3 mb-6"><a href="https://wa.me/97143402223?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%AE%D8%AF%D9%85%D8%A9%20%D9%85%D8%B1%D8%B3%D9%8A%D8%AF%D8%B3%20%D8%A8%D9%86%D8%B2%20%D9%84%D8%AF%D9%89%20%D9%85%D8%B1%D9%83%D8%B2%20%D8%AF%D9%8A%D8%AC%D9%8A-%D8%AA%D9%83%20%D8%A8%D9%8A%D8%B1%D9%81%D9%88%D8%B1%D9%85%D8%A7%D9%86%D8%B3.%20%D8%B7%D8%B1%D8%A7%D8%B2%20%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%B1%D8%A9%20%D9%88%D8%B3%D9%86%D8%AA%D9%87%D8%A7%3A%20" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-burnt-orange hover:bg-burnt-orange/90 text-black font-bold px-6 py-3 rounded-2xl transition-all duration-300 hover:scale-105 shadow-xl" data-cta-placement="booking_section"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle w-5 h-5"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>واتساب الآن</a><a href="tel:+97143402223" class="inline-flex items-center justify-center gap-2 bg-off-white text-black hover:bg-white font-bold px-6 py-3 rounded-2xl transition-all duration-300 shadow-xl" data-cta-placement="booking_section"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone w-5 h-5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>+971 4 340 2223</a></div><p class="text-gray-500 text-sm">أو استخدم النموذج لإرسال تفاصيلك مباشرة.</p></div><div class="card-premium rounded-2xl p-5 sm:p-8"><form id="brand-booking-form" class="space-y-4" novalidate=""><div class="grid sm:grid-cols-2 gap-4"><div><label for="bf-name" class="block text-sm text-gray-300 mb-2">الاسم (اختياري)</label><input id="bf-name" type="text" autoComplete="name" aria-invalid="false" class="w-full bg-black/60 border border-white/10 focus:border-burnt-orange/60 rounded-2xl px-4 py-3 text-off-white placeholder-gray-500 outline-none transition-colors" placeholder="مثال: أحمد المنصوري" maxLength="80" value=""/></div><div><label for="bf-phone" class="block text-sm text-gray-300 mb-2">رقم للاتصال (اختياري)</label><input id="bf-phone" type="tel" autoComplete="tel" aria-invalid="false" class="w-full bg-black/60 border border-white/10 focus:border-burnt-orange/60 rounded-2xl px-4 py-3 text-off-white placeholder-gray-500 outline-none transition-colors" placeholder="+971 50 000 0000" maxLength="20" value=""/></div></div><div><label for="bf-brand" class="block text-sm text-gray-300 mb-2">العلامة</label><input id="bf-brand" type="text" readonly="" class="w-full bg-black/60 border border-white/10 focus:border-burnt-orange/60 rounded-2xl px-4 py-3 text-off-white placeholder-gray-500 outline-none transition-colors opacity-80 cursor-not-allowed" value="مرسيدس بنز"/></div><div><label for="bf-issue" class="block text-sm text-gray-300 mb-2">كيف يمكننا مساعدتك؟</label><textarea id="bf-issue" rows="4" required="" aria-invalid="false" class="w-full bg-black/60 border border-white/10 focus:border-burnt-orange/60 rounded-2xl px-4 py-3 text-off-white placeholder-gray-500 outline-none transition-colors resize-none" placeholder="أخبرنا عن سيارتك وما تحتاج إليه: صيانة أو إصلاح أو تشخيص" maxLength="600"></textarea></div><button type="submit" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-burnt-orange hover:bg-burnt-orange/90 text-black font-bold px-8 py-4 rounded-2xl transition-all duration-300 hover:scale-[1.02] shadow-xl"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle w-5 h-5"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>المتابعة إلى واتساب</button><p class="text-xs text-gray-500">الاسم ورقم الهاتف اختياريان. راجع رسالتك وأرسلها في واتساب. نرد خلال ساعات العمل: الاثنين–الجمعة من 8 صباحاً إلى 6:30 مساءً، والسبت من 8 صباحاً إلى 2 مساءً.</p></form></div></div></div></section></main><footer class="border-t border-white/[0.08] bg-[#0b0c0d] py-16 sm:py-20"><div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12"><div class="grid grid-cols-1 gap-12 md:grid-cols-2 xl:grid-cols-[1.4fr_0.8fr_1fr_1.1fr] xl:gap-12"><section aria-label="مركز ديجي-تك بيرفورمانس"><a class="inline-block" href="/ar"><img src="/lovable-uploads/916789e0-b6fb-43d4-9d52-79899ce5a1c2.png" alt="مركز ديجي-تك بيرفورمانس" width="429" height="49" loading="lazy" decoding="async" class="h-9 w-auto brightness-110"/></a><p class="mt-6 max-w-sm text-sm leading-7 text-white/45">مركز دبي المتخصص في السيارات الفاخرة وتطوير الأداء، بخبرة تجمع بين الهندسة الدقيقة والخدمة الاحترافية.</p><a href="https://maps.google.com/?q=Al+Quoz+Industrial+Area+3+Dubai" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex text-sm font-medium text-white transition-colors hover:text-burnt-orange">احصل على الاتجاهات إلى ورشتنا ←</a></section><nav aria-label="روابط سريعة"><h2 class="text-sm font-semibold text-off-white">روابط سريعة</h2><div class="mt-5"><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/about">من نحن</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/services">جميع الخدمات</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/brands">العلامات التي نخدمها</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/tuning">تطوير الأداء</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/vrx">VRX</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/blog">دليل الورشة</a></div></nav><nav aria-label="خدمات مختارة"><h2 class="text-sm font-semibold text-off-white">خدمات مختارة</h2><div class="mt-5"><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/brands/mercedes-benz-service-dubai">إصلاح مرسيدس</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/services/car-diagnostics-dubai">التشخيص والبرمجة</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/services/oil-change-dubai">تغيير الزيت</a><a class="block py-1.5 text-sm text-white/45 transition-colors hover:text-white" href="/ar/services/transmission-repair-dubai">إصلاح ناقل الحركة</a><a class="block py-1.5