diff --git a/src/lib/ppf-enquiry.ts b/src/lib/ppf-enquiry.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/ppf-enquiry.ts
@@ -0,0 +1,59 @@
+/** Restricted, self-reported acquisition context for a WhatsApp draft only.
+ * Never treats client labels or an enquiry reference as proof of receipt/sale.
+ * No persistence, network access or analytics emission belongs in this module.
+ */
+const sources = new Set(['google', 'bing', 'chatgpt', 'openai', 'perplexity', 'gemini', 'claude', 'copilot', 'duckduckgo', 'instagram', 'facebook', 'youtube', 'newsletter', 'whatsapp']);
+const media = new Set(['organic', 'cpc', 'ppc', 'paid_search', 'paid_social', 'social', 'email', 'referral', 'display', 'direct', 'organic_social']);
+const landingPaths = new Set(['/', '/ar', '/services', '/ar/services', ...['/services/paint-protection-film', '/services/paint-protection-dubai', '/services/ceramic-coating', '/blog/ceramic-coating-vs-ppf-dubai'].flatMap(path => [path, '/ar' + path]), '/services/car-polishing-dubai']);
+const searchGroups = new Set(['ppf_general', 'ppf_full_body', 'ppf_quote']);
+const safeLabel = (value: unknown, allowed: Set<string>) => typeof value === 'string' && allowed.has(value.toLowerCase().trim()) ? value.toLowerCase().trim() : 'unknown';
+
+export interface PpfEnquiryContext {
+  source: string;
+  medium: string;
+  campaign: string;
+  ad_group: string;
+  landing_page: string;
+}
+
+export function buildPpfEnquiryContext(href: string, firstTouch: unknown = {}): PpfEnquiryContext {
+  const url = new URL(href);
+  const stored = firstTouch && typeof firstTouch === 'object' && !Array.isArray(firstTouch) ? firstTouch as Record<string, unknown> : {};
+  // A tagged current visit is kept together. Never attach a current campaign to
+  // source/medium/landing from a different stored first-touch visit.
+  const tagged = url.searchParams.has('utm_source') || url.searchParams.has('utm_medium') || url.searchParams.has('utm_campaign');
+  const source = safeLabel(tagged ? url.searchParams.get('utm_source') : stored.utm_source, sources);
+  const medium = safeLabel(tagged ? url.searchParams.get('utm_medium') : stored.utm_medium, media);
+  let landing = tagged ? url.href : typeof stored.landing_page === 'string' ? stored.landing_page : url.href;
+  try {
+    const parsed = new URL(landing, url.origin);
+    landing = parsed.origin === url.origin && landingPaths.has(parsed.pathname) ? parsed.pathname : 'unknown';
+  } catch { landing = 'unknown'; }
+  let campaign = 'unknown';
+  let adGroup = 'unknown';
+  const candidate = url.searchParams.get('utm_campaign');
+  const group = url.searchParams.get('utm_content');
+  if (tagged && source === 'google' && ['cpc', 'ppc', 'paid_search'].includes(medium) && candidate === 'ppf_search') {
+    campaign = candidate;
+    if (group && searchGroups.has(group)) adGroup = group;
+  } else if (tagged && ['facebook', 'instagram'].includes(source) && medium === 'paid_social' && ['ppf_meta_prospecting', 'ppf_meta_retargeting'].includes(candidate ?? '')) {
+    campaign = candidate!;
+    const expectedGroup = candidate === 'ppf_meta_prospecting' ? 'ppf_prospecting' : 'ppf_retargeting';
+    if (group === expectedGroup) adGroup = group;
+  }
+  return { source, medium, campaign, ad_group: adGroup, landing_page: landing };
+}
+
+export function createPpfEnquiryReference(random: Pick<Crypto, 'getRandomValues'> = crypto): string {
+  const bytes = random.getRandomValues(new Uint8Array(12));
+  return 'PPF-' + Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('').toUpperCase();
+}
+
+export function ppfReferenceLines(reference: string, context: PpfEnquiryContext): string[] {
+  return [
+    'Enquiry reference: ' + reference,
+    'Reported source / medium: ' + context.source + ' / ' + context.medium,
+    'Reported campaign / ad group: ' + context.campaign + ' / ' + context.ad_group,
+    'Landing page: ' + context.landing_page,
+  ];
+}
diff --git a/scripts/test-ppf-enquiry.mjs b/scripts/test-ppf-enquiry.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/test-ppf-enquiry.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import ts from 'typescript';
+
+const source = await readFile('src/lib/ppf-enquiry.ts', 'utf8');
+const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022 } }).outputText;
+const { buildPpfEnquiryContext: context, createPpfEnquiryReference: reference, ppfReferenceLines: lines } = await import('data:text/javascript;base64,' + Buffer.from(compiled).toString('base64'));
+const base = 'https://digitecme.com/services/paint-protection-film';
+for (const group of ['ppf_general', 'ppf_full_body', 'ppf_quote']) {
+  assert.deepEqual(context(base + '?utm_source=google&utm_medium=cpc&utm_campaign=ppf_search&utm_content=' + group), {
+    source: 'google', medium: 'cpc', campaign: 'ppf_search', ad_group: group, landing_page: '/services/paint-protection-film',
+  });
+}
+const invalid = context(base + '?utm_source=PRIVATE_NAME&utm_medium=PRIVATE_PHONE&utm_campaign=PRIVATE_VIN&utm_content=PRIVATE_EMAIL&gclid=PRIVATE_CLICK#PRIVATE_HASH', { landing_page: 'https://evil.example/PRIVATE_PATH', name: 'PRIVATE_NAME' });
+assert.deepEqual(invalid, { source: 'unknown', medium: 'unknown', campaign: 'unknown', ad_group: 'unknown', landing_page: '/services/paint-protection-film' });
+assert.doesNotMatch(JSON.stringify(invalid), /PRIVATE|gclid|#/);
+assert.equal(context(base, { landing_page: 'https://evil.example/private', utm_source: 'google', utm_medium: 'organic' }).landing_page, 'unknown');
+assert.equal(context(base, { landing_page: 'https://digitecme.com/PRIVATE_NAME?phone=PRIVATE_PHONE', utm_source: 'google' }).landing_page, 'unknown');
+const first = context(base, { landing_page: 'https://digitecme.com/services?name=PRIVATE_NAME', utm_source: 'bing', utm_medium: 'organic', utm_campaign: 'PRIVATE' });
+assert.deepEqual(first, { source: 'bing', medium: 'organic', campaign: 'unknown', ad_group: 'unknown', landing_page: '/services' });
+const mixed = context(base + '?utm_campaign=ppf_search&utm_content=ppf_general', { utm_source: 'google', utm_medium: 'cpc', landing_page: base });
+assert.equal(mixed.campaign, 'unknown', 'Do not mix current campaign with a stored source from another visit');
+for (const [campaign, group] of [['ppf_meta_prospecting', 'ppf_prospecting'], ['ppf_meta_retargeting', 'ppf_retargeting']]) {
+  assert.equal(context(base + '?utm_source=instagram&utm_medium=paid_social&utm_campaign=' + campaign + '&utm_content=' + group).ad_group, group);
+}
+assert.equal(context(base + '?utm_source=facebook&utm_medium=paid_social&utm_campaign=ppf_meta_prospecting&utm_content=ppf_retargeting').ad_group, 'unknown');
+assert.equal(context(base + '?utm_source=google&utm_medium=organic&utm_campaign=ppf_search&utm_content=ppf_general').campaign, 'unknown');
+assert.equal(context(base, null).source, 'unknown');
+const id = reference({ getRandomValues: bytes => bytes.fill(42) });
+assert.match(id, /^PPF-[0-9A-F]{24}$/);
+assert.equal(new Set(Array.from({ length: 1000 }, () => reference())).size, 1000);
+assert.throws(() => reference({ getRandomValues() { throw new Error('unavailable'); } }));
+assert.equal(lines(id, first)[0], 'Enquiry reference: ' + id);
+assert.doesNotMatch(lines(id, first).join('\n'), /PRIVATE/);
+assert.doesNotMatch(source, /localStorage|sessionStorage|window\.gtag|fetch\(/, 'Helper must have no analytics, persistence or network side effects');
+console.log('PPF enquiry tests passed: random draft references, controlled acquisition labels, unknown attribution, no mixed touches, PII/query exclusion and no side effects.');
